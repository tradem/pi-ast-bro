{
  "name": "pi-ast-bro",
  "version": "1.0.0-beta.10",
  "description": "Pi extension integrating the ast-bro CLI for AST-based context saving and pre-flight syntax checks.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "version:alpha": "node scripts/update-version.js"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^26.6.5",
    "typebox": "^1.3.37",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "pi-extension",
    "ast-bro",
    "ast"
  ],
  "files": [
    "src",
    "skills",
    "package.json",
    "README.md"
  ],
  "license": "MIT"
}
